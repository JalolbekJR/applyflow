APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-replace-before-shared-use
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave DATABASE_URL unset for the local SQLite bootstrap.
# PostgreSQL example: postgresql://applyflow:replace-me@127.0.0.1:5432/applyflow
DATABASE_URL=

# Anonymous draft security. Insecure draft cookies are allowed only when APP_ENV=development.
# DRAFT_COOKIE_PATH is fixed for Phase 3 and unsafe alternatives are rejected at startup.
DRAFT_COOKIE_NAME=applyflow_draft
DRAFT_COOKIE_PATH=/api/v1/application-drafts/
DRAFT_COOKIE_SECURE=false
DRAFT_INACTIVITY_SECONDS=604800
DRAFT_ABSOLUTE_SECONDS=2592000
DRAFT_CREATION_COOKIE_NAME=applyflow_draft_creation
DRAFT_CREATION_KEY_LIFETIME_SECONDS=600
