# Normalize text files in the Git repository
* text=auto

# Cross-platform source and configuration files
*.py       text eol=lf
*.pyi      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.vue      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
.gitattributes text eol=lf
LICENSE    text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
Dockerfile text eol=lf

# Windows-native scripts
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.pdf      binary
*.zip      binary
